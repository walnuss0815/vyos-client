# Pinned VyOS builds used for real-VyOS end-to-end testing (see
# e2e/README.md). VyOS has three release channels - rolling, Stream,
# and LTS (docs.vyos.io/en/latest/installation/install.html) - of
# which only rolling and Stream are usable here: LTS images require a
# paid/contributor subscription (support.vyos.io), so they're not
# available to this repo's public CI.
#
# This suite tests against 5 targets: the current rolling build, plus
# the last 4 VyOS Stream releases (Stream ships roughly quarterly - see
# https://vyos.net/get/stream/). Each is downloaded/verified
# independently by download-vyos-iso.sh <version-key>, where
# <version-key> is one of: rolling, stream-0 (newest), stream-1,
# stream-2, stream-3 (oldest of the 4 kept).
#
# Renovate-maintained (see renovate.json's customManagers):
#   - VYOS_ROLLING_TAG, against vyos/vyos-nightly-build's GitHub
#     Releases - a real, structured API, so this one is always kept at
#     the actual latest rolling build.
#   - VYOS_STREAM_0_TAG, against an HTML scrape of
#     https://vyos.net/get/stream/ (VyOS Stream has no structured
#     release feed/API at all - this is the only source of truth) -
#     always kept at the actual latest Stream release.
#
# Manually maintained (NOT touched by Renovate - see this section's
# own comment above VYOS_STREAM_1_TAG below for why, and the "Re-pinning
# VyOS Stream" section of e2e/README.md for the rotation procedure):
#   - VYOS_STREAM_1_TAG, VYOS_STREAM_2_TAG, VYOS_STREAM_3_TAG - the
#     previous 3 Stream releases, shifted down by one slot (dropping
#     the oldest) whenever a new Stream release makes VYOS_STREAM_0_TAG
#     move. Since Stream itself only ships ~quarterly, this needs a
#     human touch a few times a year at most - about as often as
#     rolling itself used to need re-pinning before it was
#     Renovate-automated.

# --- Minisign public keys, one per channel (VyOS's own, published at
# https://vyos.net/get/nightly-builds/ and https://vyos.net/get/stream/
# respectively) - not expected to change; re-verify against those
# pages if they ever do. Shared across every tag in their channel, so
# these aren't per-version and aren't Renovate-tracked. ---
VYOS_ROLLING_MINISIGN_PUBKEY="RWSIhkR/dkM2DSaBRniv/bbbAf8hmDqdbOEmgXkf1RxRoxzodgKcDyGq"
VYOS_STREAM_MINISIGN_PUBKEY="RWTR1ty93Oyontk6caB9WqmiQC4fgeyd/ejgRxCRGd2MQej7nqebHneP"

# --- Rolling: a vyos/vyos-nightly-build GitHub release tag. Renovate-maintained. ---
# renovate: datasource=github-releases depName=vyos/vyos-nightly-build
VYOS_ROLLING_TAG=2026.08.25-0014-rolling

# --- Stream: the last 4 releases, newest first. Tag format has varied
# over Stream's own history (older: "1.5-stream-YYYY-QN"; current:
# "YYYY.MM") - download-vyos-iso.sh derives each one's download URL
# from the tag the same way regardless of which format it is. ---

# Renovate-maintained (see renovate.json's customDatasources.vyos-stream-latest).
# renovate: datasource=custom.vyos-stream-latest depName=vyos-stream
VYOS_STREAM_0_TAG=2026.03

# Manually maintained - see this file's own top-of-file comment.
VYOS_STREAM_1_TAG=2026.02
VYOS_STREAM_2_TAG=2025.11
VYOS_STREAM_3_TAG=1.5-stream-2025-Q2
