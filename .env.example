# Copy this file to .env before running `docker compose up`.
# .env is gitignored (see .gitignore) - never commit real secrets.
#
# The defaults below are wired to work out of the box against the
# mock-vyos service that docker-compose.yml also starts, for local
# testing/development without a real router. To point VyOS Client at a
# REAL VyOS instance instead, change VYOS_API_URL and VYOS_API_KEY below
# and run `docker compose up vyos-client --no-deps` to skip starting
# mock-vyos.

# --- Port exposed on the host (see docker-compose.yml) ---
HOST_PORT=8443

# --- Required: VyOS REST API ---
# Default points at the bundled mock-vyos service. For a real router:
#   VYOS_API_URL=https://<router-ip>
VYOS_API_URL=http://mock-vyos:8443
VYOS_API_KEY=dev-key

# --- VyOS Client's own login ---
# AUTH_MODE=vyos-users (the default; no need to set it explicitly) logs
# in with a real local VyOS user's own password, read from `system
# login user <name> authentication encrypted-password` via VYOS_API_KEY
# above - no separate credential to manage. Nothing to configure here:
# mock-vyos is pre-seeded with a real, working admin/admin account (see
# backend/cmd/mock-vyos/main.go) for this default flow to work out of
# the box; against a REAL router, log in with any existing `system
# login user` account instead.
#
# Set AUTH_MODE=static to use a single shared UI account independent of
# VyOS's own user database instead (e.g. as a break-glass login that
# doesn't depend on VyOS's API being reachable) - uncomment the three
# lines below if you want that:
#
# AUTH_MODE=static
# UI_ADMIN_USER=admin
# Generate your own hash with:
#   docker run --rm ghcr.io/<org>/vyos-client:latest hash-password
# IMPORTANT: bcrypt hashes contain literal "$" characters, which Docker
# Compose treats as variable-interpolation syntax in .env files. Every
# "$" MUST be doubled ("$$") or Compose will silently mangle the hash
# (and VyOS Client will reject every login) - e.g.
# UI_ADMIN_PASSWORD_HASH=$$2a$$10$$e031EPEFmqEnR79n.SBQeefVMbft1/6g4HeBJ2bdXl9dknci1Uq8W

# --- Optional ---
# Set explicitly so sessions survive `docker compose restart`.
SESSION_SECRET=local-dev-session-secret-change-me

# Only relevant when VYOS_API_URL is https:// with a self-signed cert
# (e.g. a real router you haven't put a real certificate on yet).
# VYOS_API_INSECURE_SKIP_VERIFY=true

# SAFE_APPLY_DEFAULT_SECONDS=90

# Shows a persistent "configuration warnings" banner (firewall
# default-action, SSH password auth, HTTPS API restrictions, SNMP
# default community strings, users with no password/SSH key).
# Disabled by default - these are opinionated security-posture
# judgment calls, not factual VyOS state.
# CONFIG_WARNINGS_ENABLED=true

# Serves plain HTTP instead of HTTPS. Only do this behind a trusted
# reverse proxy that terminates real TLS, or on a fully isolated/
# trusted network - see docs/security.md. Login/session cookies are
# unencrypted on the wire in this mode.
# TLS_ENABLED=false

# The session/CSRF cookies' Secure flag defaults to matching
# TLS_ENABLED. Override it independently if you're behind a trusted
# reverse proxy that terminates real TLS (TLS_ENABLED=false above,
# since this process itself only ever sees plain HTTP from the proxy)
# but still want Secure cookies - the browser's own connection to the
# proxy genuinely is HTTPS, even though this process's own listener
# isn't. See docs/security.md's TLS section.
# COOKIE_SECURE=true

# Turns on the System > Upgrades page, which checks this app's own
# GitHub releases for an update and can pull the new image/queue the
# `container name ... image ...` config change for you. Disabled by
# default - this is the only outbound-to-the-internet call anywhere in
# the backend (everything else only ever talks to VyOS's own API). If
# you enable it, SELF_UPGRADE_CONTAINER_NAME is also required - it must
# match the name you used in `set container name <NAME> image ...` on
# VyOS, since the backend has no other way to know this about itself.
# SELF_UPGRADE_ENABLED=true
# SELF_UPGRADE_CONTAINER_NAME=vyos-client
# Only needed for a fork publishing its own releases/images:
# SELF_UPGRADE_GITHUB_REPO=<org>/vyos-client

# Turns on the Containers page's "Check for update" button for EVERY
# container configured on the router (not just this app's own) - see
# docs/architecture.md#container-image-update-checks. Disabled by
# default: unlike self-upgrade above, this contacts whatever registry
# a container's own image reference points at (Docker Hub, GHCR,
# Quay, or a self-hosted registry), triggered manually per container
# rather than automatically. No further configuration needed - the
# registry and repository are derived entirely from each container's
# own `image` value.
# CONTAINER_UPDATE_CHECKS_ENABLED=true
