# Application credentials (passed to the container at runtime)
APP_USER=admin
APP_PASSWORD=change-me

# JWT signing secret – use a long, randomly generated string in production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=8h

# VyOS API connection
VYOS_HOST=https://192.0.2.1
VYOS_KEY=replace-with-vyos-api-key

# Set to "true" when VyOS uses a valid, trusted TLS certificate
VYOS_VERIFY_TLS=false

# Allowed browser origin for CORS (use specific origin in production)
CORS_ORIGIN=*
